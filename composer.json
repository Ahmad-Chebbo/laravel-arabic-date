{
    "name": "ahmad-chebbo/laravel-arabic-date",
    "description": "A Laravel package for formatting dates in Arabic, with civil Hijri (Islamic) calendar conversion",
    "keywords": ["laravel", "arabic", "date", "islamic", "calendar", "hijri"],
    "version": "1.3.0",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ahmad Chebbo",
            "email": "ahmad.m.chebbo@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4",
        "illuminate/contracts": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "nesbot/carbon": "^2.0|^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "AhmadChebbo\\LaravelArabicDate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AhmadChebbo\\LaravelArabicDate\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AhmadChebbo\\LaravelArabicDate\\ArabicDateServiceProvider"
            ],
            "aliases": {
                "ArabicDate": "AhmadChebbo\\LaravelArabicDate\\Facades\\ArabicDate"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
